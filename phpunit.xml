<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- APP_ENV forcé à testing. Dans le conteneur de dev, APP_ENV=local est
             une VRAIE variable d'environnement (compose.yaml) : un <env> simple ne
             la surcharge pas, et app()->runningUnitTests() vaudrait false — les
             helpers de test Filament (fillForm(), etc.) ne feraient alors RIEN.
             Il faut les DEUX lignes : force="true" sur <env> ne réécrit que
             getenv()/$_ENV, or Laravel lit $_SERVER en premier (qui contient
             l'APP_ENV réel du process) ; <server> réécrit $_SERVER, toujours.
             Les autres <env> ne sont PAS forcés : compose ne pose que
             APP_ENV/APP_DEBUG, le reste vient de .env, que phpunit.xml prime déjà.
             DB_DATABASE doit surtout rester surchargeable : le Makefile passe
             -e DB_DATABASE=testing_<slug> en worktree. Cf. docs/workflow.md. -->
        <server name="APP_ENV" value="testing"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Les factories Lunar appellent $faker->state, formatter absent de
             la locale fr_FR : sous APP_FAKER_LOCALE=fr_FR (le .env du projet),
             CartAddressFactory échoue une fois sur deux, au hasard du booléen
             qui garde l'appel. On fige la locale des tests sur en_US. -->
        <env name="APP_FAKER_LOCALE" value="en_US"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
