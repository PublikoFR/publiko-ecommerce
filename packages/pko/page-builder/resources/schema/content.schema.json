{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://publiko.fr/schemas/page-builder/content.schema.json",
  "title": "pko/page-builder content tree",
  "description": "Arborescence JSON stockée dans la colonne `content` des tables pko_pages et pko_posts. Représente une page composée de sections, chaque section contenant 1 à 3 colonnes, chaque colonne contenant une liste de blocs (text, image, code).",
  "type": "object",
  "required": ["sections"],
  "additionalProperties": false,
  "properties": {
    "heading": {
      "type": "string",
      "maxLength": 250,
      "description": "Titre H1 affiché en tête de page (on-page). Peut différer du nom du contenu en base pour le SEO. Toujours présent côté éditeur, non supprimable."
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": ["id", "layout", "columns"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layout": { "enum": ["1col", "2col", "3col", "4col", "5col", "6col"] },
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t": { "type": "integer", "minimum": 0, "maximum": 400 },
            "r": { "type": "integer", "minimum": 0, "maximum": 400 },
            "b": { "type": "integer", "minimum": 0, "maximum": 400 },
            "l": { "type": "integer", "minimum": 0, "maximum": 400 }
          }
        },
        "margin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t": { "type": "integer", "minimum": 0, "maximum": 400 },
            "b": { "type": "integer", "minimum": 0, "maximum": 400 }
          }
        },
        "background_color": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
        "text_color": { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/definitions/column" }
        }
      }
    },
    "column": {
      "type": "object",
      "required": ["blocks"],
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/definitions/block" }
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/definitions/blockText" },
        { "$ref": "#/definitions/blockImage" },
        { "$ref": "#/definitions/blockCode" },
        { "$ref": "#/definitions/blockQuote" },
        { "$ref": "#/definitions/blockButton" },
        { "$ref": "#/definitions/blockSeparator" },
        { "$ref": "#/definitions/blockCallout" },
        { "$ref": "#/definitions/blockTitle" },
        { "$ref": "#/definitions/blockVideo" },
        { "$ref": "#/definitions/blockList" },
        { "$ref": "#/definitions/blockAccordion" },
        { "$ref": "#/definitions/blockGallery" }
      ]
    },
    "blockText": {
      "type": "object",
      "required": ["id", "type", "html"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "text" },
        "html": { "type": "string" }
      }
    },
    "blockImage": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "image" },
        "media_id": { "type": ["integer", "null"] },
        "url": { "type": ["string", "null"] },
        "alt": { "type": "string" }
      }
    },
    "blockCode": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "code" },
        "language": {
          "enum": ["plain", "php", "js", "ts", "html", "css", "bash", "json", "sql", "yaml"]
        },
        "content": { "type": "string" }
      }
    },
    "blockQuote": {
      "type": "object",
      "required": ["id", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "quote" },
        "text": { "type": "string", "description": "Texte de la citation (brut, sans HTML)." },
        "cite": { "type": "string", "description": "Auteur / source, optionnel." }
      }
    },
    "blockButton": {
      "type": "object",
      "required": ["id", "type", "label", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "button" },
        "label": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "description": "http(s)://, lien interne /…, #ancre, mailto: ou tel: uniquement." },
        "variant": { "enum": ["primary", "accent", "secondary"] }
      }
    },
    "blockSeparator": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "separator" },
        "variant": { "enum": ["line", "space", "space-sm", "space-md", "space-lg", "space-xl"] }
      }
    },
    "blockCallout": {
      "type": "object",
      "required": ["id", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "callout" },
        "variant": { "enum": ["info", "warning", "danger"], "description": "info = bleu, warning = orange, danger = rouge." },
        "text": { "type": "string", "description": "Message de l'encart (brut, sans HTML)." }
      }
    },
    "blockTitle": {
      "type": "object",
      "required": ["id", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "title" },
        "level": { "enum": ["h2", "h3"] },
        "text": { "type": "string", "maxLength": 200 }
      }
    },
    "blockVideo": {
      "type": "object",
      "required": ["id", "type", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "video" },
        "url": { "type": "string", "description": "URL YouTube / Vimeo / Dailymotion / .mp4 (http(s) uniquement), résolue au rendu." }
      }
    },
    "blockList": {
      "type": "object",
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "list" },
        "style": { "enum": ["bullet", "check"] },
        "items": { "type": "array", "items": { "type": "string" } }
      }
    },
    "blockAccordion": {
      "type": "object",
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "accordion" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["q", "a"],
            "additionalProperties": false,
            "properties": {
              "q": { "type": "string", "description": "Question / titre du panneau." },
              "a": { "type": "string", "description": "Réponse / contenu." }
            }
          }
        }
      }
    },
    "blockGallery": {
      "type": "object",
      "required": ["id", "type", "media_ids"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "gallery" },
        "media_ids": { "type": "array", "items": { "type": "integer" } },
        "columns": { "enum": [2, 3, 4] }
      }
    }
  }
}
