{
    "name": "pko/lunar-mail-templates",
    "description": "Socle d'e-mails transactionnels éditables : templates stockés en base, rendu par blocs, placeholders validés.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "filament/filament": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pko\\MailTemplates\\": "src/",
            "Pko\\MailTemplates\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pko\\MailTemplates\\MailTemplatesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
