# =====================================================================
#  Config de déploiement — DEV (Weklo → O2switch, sous-domaine dev.)
#  cp deploy/dev.env.example deploy/dev.env   (dev.env est gitignoré)
#  AUCUN secret ici : SSH_KEY est un CHEMIN, pas la clé elle-même.
#  Le .env Laravel serveur (creds DB/APP DEV) se pose À LA MAIN, une
#  fois, dans REMOTE_PATH — ni transféré ni écrasé par le script.
# =====================================================================

# --- Connexion SSH O2switch (OBLIGATOIRE) ----------------------------
SSH_HOST=TODO.o2switch.net
SSH_USER=TODO_cpanel_user
SSH_PORT=22

# Chemin de la clé privée SSH (jamais la clé en clair).
SSH_KEY=~/.ssh/weklo-o2switch

# --- Cible sur le serveur (OBLIGATOIRE) ------------------------------
# Racine de l'app Laravel pour l'environnement DEV. Le sous-domaine
# dev.weklo.fr doit avoir son document root sur REMOTE_PATH/public.
# Ex O2switch : /home/<cpanel_user>/dev.weklo.fr
REMOTE_PATH=/home/TODO_cpanel_user/dev.weklo.fr

# --- Exécution côté serveur ------------------------------------------
REMOTE_PHP=php

# --- Déploiement -----------------------------------------------------
DRY_RUN=false          # true = simulation (rsync --dry-run, pas de SSH distant)
RUN_MIGRATIONS=true    # php artisan migrate --force après le rsync

# Build composer via Docker (PHP 8.3 = version serveur ; l'hôte est en 8.2, or des deps exigent 8.3)
BUILD_COMPOSER="docker compose -p ecom-laravel exec -T -u sail app composer"
