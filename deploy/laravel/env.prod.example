# =====================================================================
#  .env Laravel — PROD (Weklo sur O2switch)
#  Ce fichier se pose À LA MAIN sur le serveur dans REMOTE_PATH (le dossier
#  qui contient `artisan`), une seule fois. Il n'est JAMAIS transféré par
#  deploy.sh (exclu du rsync) ni commité (secrets).
#
#  Étapes : 1) remplir les TODO  2) générer APP_KEY (voir deploy/README.md)
#           3) uploader ce fichier renommé « .env » dans REMOTE_PATH prod.
# =====================================================================

APP_NAME="Weklo"
APP_ENV=production
APP_KEY=            # TODO : `php artisan key:generate --show` → colle base64:...
APP_DEBUG=false
APP_TIMEZONE=Europe/Paris
APP_URL=https://TODO-domaine-prod            # ex: https://weklo.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de données (cPanel → MySQL Databases, préfixe goga8238_) --------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=goga8238_TODO_prod
DB_USERNAME=goga8238_TODO
DB_PASSWORD=TODO

# --- Drivers mutualisé (pas de Redis sur O2switch par défaut) --------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=weklo_prod

# --- Mail (compte e-mail créé dans cPanel) --------------------------------
MAIL_MAILER=smtp
MAIL_HOST=TODO-mail.o2switch          # ex: la boîte @weklo.fr → mail.weklo.fr
MAIL_PORT=465
MAIL_USERNAME=TODO@weklo.fr
MAIL_PASSWORD=TODO
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@weklo.fr"
MAIL_FROM_NAME="${APP_NAME}"

# --- Lunar / paiements ----------------------------------------------------
PAYMENTS_TYPE=cash-in-hand
STRIPE_PK=            # TODO clés Stripe LIVE
STRIPE_SECRET=
LUNAR_STRIPE_WEBHOOK_SECRET=

# --- Transporteurs (renseigner en prod) -----------------------------------
CHRONOPOST_ACCOUNT=
CHRONOPOST_PASSWORD=
CHRONOPOST_SUB_ACCOUNT=
COLISSIMO_CONTRACT=
COLISSIMO_PASSWORD=
COLISSIMO_WSDL_URL=https://ws.colissimo.fr/sls-ws/SlsServiceWS?wsdl

# --- Adresse expéditeur ---------------------------------------------------
SHIPPER_NAME="Weklo"
SHIPPER_STREET="TODO"
SHIPPER_ZIP="TODO"
SHIPPER_CITY="TODO"
SHIPPER_COUNTRY="FR"
SHIPPER_PHONE="TODO"
SHIPPER_EMAIL="logistique@weklo.fr"
