# =====================================================================
#  Config de déploiement — PROD (Weklo → O2switch)
#  cp deploy/prod.env.example deploy/prod.env   (prod.env est gitignoré)
#  AUCUN secret ici : SSH_KEY est un CHEMIN, pas la clé elle-même.
#  Le .env Laravel serveur (creds DB/APP) se pose À LA MAIN, une fois,
#  dans REMOTE_PATH — il n'est NI transféré NI écrasé par le script.
# =====================================================================

# --- Connexion SSH O2switch (OBLIGATOIRE) ----------------------------
# SSH_HOST : hôte SSH du serveur mutualisé (cPanel → Informations serveur,
#            ex: nodeXXX.o2switch.net). Souvent = le domaine marche aussi.
SSH_HOST=TODO.o2switch.net
# SSH_USER : identifiant cPanel O2switch.
SSH_USER=TODO_cpanel_user
# Port SSH O2switch (22 par défaut).
SSH_PORT=22

# Chemin de la clé privée SSH (jamais la clé en clair).
# Clé publique à installer via cPanel → SSH Access → Manage SSH Keys.
SSH_KEY=~/.ssh/weklo-o2switch

# --- Cible sur le serveur (OBLIGATOIRE) ------------------------------
# Racine de l'app Laravel (dossier contenant `artisan`). En prod, le
# document root du domaine dans cPanel doit pointer sur REMOTE_PATH/public.
# Ex O2switch : /home/<cpanel_user>/weklo.fr
REMOTE_PATH=/home/TODO_cpanel_user/weklo.fr

# --- Exécution côté serveur ------------------------------------------
# php CLI ≥ 8.2 (Laravel 11). O2switch = CloudLinux : le wrapper `php` suit la
# version choisie dans cPanel « Sélectionner une version de PHP » (défaut 8.1 →
# à passer en 8.3, avec pdo_mysql/mbstring/bcmath/gd/intl/zip activés).
REMOTE_PHP=php

# --- Déploiement -----------------------------------------------------
DRY_RUN=false          # true = simulation (rsync --dry-run, pas de SSH distant)
RUN_MIGRATIONS=true    # php artisan migrate --force après le rsync
