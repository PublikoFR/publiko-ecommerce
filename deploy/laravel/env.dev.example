# =====================================================================
#  .env Laravel — DEV / staging (Weklo sur O2switch)
#  Idem prod : posé À LA MAIN dans le REMOTE_PATH dev, jamais transféré/commité.
#  Différences vs prod : DEBUG activé, sa propre base, son propre domaine.
# =====================================================================

APP_NAME="Weklo (dev)"
APP_ENV=staging
APP_KEY=            # TODO : `php artisan key:generate --show` (clé DISTINCTE de prod)
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=https://TODO-domaine-dev             # ex: https://dev.weklo.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (SÉPARÉE de la prod — cPanel → MySQL Databases) -------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=goga8238_TODO_dev
DB_USERNAME=goga8238_TODO
DB_PASSWORD=TODO

# --- Drivers mutualisé -----------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=weklo_dev

# --- Mail (en dev : log recommandé pour ne pas envoyer de vrais e-mails) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@dev.weklo.fr"
MAIL_FROM_NAME="${APP_NAME}"

# --- Lunar / paiements (clés TEST en dev) ---------------------------------
PAYMENTS_TYPE=cash-in-hand
STRIPE_PK=            # clés Stripe TEST
STRIPE_SECRET=
LUNAR_STRIPE_WEBHOOK_SECRET=

# --- Transporteurs (vides / test en dev) ----------------------------------
CHRONOPOST_ACCOUNT=
CHRONOPOST_PASSWORD=
CHRONOPOST_SUB_ACCOUNT=
COLISSIMO_CONTRACT=
COLISSIMO_PASSWORD=
COLISSIMO_WSDL_URL=https://ws.colissimo.fr/sls-ws/SlsServiceWS?wsdl

# --- Adresse expéditeur ---------------------------------------------------
SHIPPER_NAME="Weklo (dev)"
SHIPPER_STREET="12 rue des Artisans"
SHIPPER_ZIP="69007"
SHIPPER_CITY="Lyon"
SHIPPER_COUNTRY="FR"
SHIPPER_PHONE="0478000000"
SHIPPER_EMAIL="logistique@dev.weklo.fr"
